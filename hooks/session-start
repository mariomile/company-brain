#!/usr/bin/env bash
# SessionStart hook for the company-brain plugin. Emits one JSON object with additionalContext.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Only speak when the working directory is inside a company brain (walk up to its root).
BRAIN_ROOT="$PWD"
while [ ! -f "$BRAIN_ROOT/_system/brain.config.json" ]; do
  [ "$BRAIN_ROOT" = "/" ] && exit 0
  BRAIN_ROOT="$(dirname "$BRAIN_ROOT")"
done
[ -f "$BRAIN_ROOT/AGENTS.md" ] || exit 0

hub_content=$(cat "${PLUGIN_ROOT}/skills/using-company-brain/SKILL.md")

shell_quote() { printf '%q' "$1"; }

escape_for_json() {
  local s="$1" char escaped i
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  for ((i=1; i<32; i++)); do
    printf -v char '%b' "\\$(printf '%03o' "$i")"
    printf -v escaped '\\u%04x' "$i"
    s="${s//"$char"/$escaped}"
  done
  printf '%s' "$s"
}

session_context="You are inside a company brain (built from the company-brain template). The company-brain plugin is installed.

**Plugin installation root:** ${PLUGIN_ROOT}
Resolve skills/, references/ and scripts/ from this root, never from the brain. Run the script from the brain root so reports and logs land there. Skills and agents are namespaced company-brain:.

**The using-company-brain skill is already loaded below.** Apply it within the user's request and existing authorization; load other skills as needed:

${hub_content}"

if command -v node >/dev/null 2>&1; then
  script_command="node $(shell_quote "${PLUGIN_ROOT}/scripts/brain.mjs")"
  session_context+="

**Brain script:** \`${script_command}\`. Run it from the brain root (${BRAIN_ROOT}). Subcommands: brief, health, stale, links, orphans, tags, ratio, index, new <type> \"Title\", verify <note>, log <op> <title> [--result], search <query>, metrics, samples, sync [message], run <automation>, scope <automation>, setup, routine <automation>."
  if brief_out=$(node "${PLUGIN_ROOT}/scripts/brain.mjs" brief --root "$BRAIN_ROOT" 2>&1); then
    session_context+="

**Brain briefing:**

${brief_out}"
  else
    session_context+="

**Brain briefing unavailable:** ${brief_out}
Read _system/agent/NOW.md and _system/memory/open-loops.md before working; do not infer state from a failed briefing."
  fi
else
  session_context+="

**Node.js is not installed.** The brain script, the briefing and the guard need it: the guard blocks every file write in this brain until Node 18 or newer is installed (https://nodejs.org). Tell the person this first, in one line, before anything else."
fi

context_json=$(escape_for_json "$session_context")
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{"additional_context":"%s"}\n' "$context_json"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$context_json"
else
  printf '{"additionalContext":"%s"}\n' "$context_json"
fi
